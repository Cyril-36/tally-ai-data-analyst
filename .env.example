# LLM provider (OpenAI-compatible endpoint). Put real values in .env, never commit them.
LLM_BASE_URL=https://aicredits.in/v1
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_S=60

# App
APP_SECRET_KEY=change-me-to-a-long-random-string
DATA_DIR=./var
MAX_UPLOAD_MB=50
# Reference date for demo data; fixtures always use 2026-09-30.
DEMO_REFERENCE_DATE=

# Optional admin seed (otherwise use: uv run app create-admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
